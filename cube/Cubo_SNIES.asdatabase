      <MdxScripts>
        <MdxScript>
          <ID>MdxScript</ID>
          <Name>MdxScript</Name>
          <CreatedTimestamp>0001-01-01T05:00:00Z</CreatedTimestamp>
          <LastSchemaUpdate>0001-01-01T05:00:00Z</LastSchemaUpdate>
          <Commands>
            <Command>
              <Text>/*
The CALCULATE command controls the aggregation of leaf cells in the cube.
If the CALCULATE command is deleted or modified, the data within the cube is affected.
You should edit this command only if you manually specify how the cube is aggregated.
*/
CALCULATE; 
CREATE MEMBER CURRENTCUBE.[Measures].[% Alta Calidad]
 AS IIF([Measures].[Numero de Programas] = 0, NULL,
    CoalesceEmpty(
        ([Measures].[Numero de Programas],
         [Estado Calidad].[Reconocimiento Ministerio].&amp;[ACREDITACIÓN DE ALTA CALIDAD]),
        0
    )
    / [Measures].[Numero de Programas]), 
FORMAT_STRING = "Percent", 
VISIBLE = 1  ; 
CREATE MEMBER CURRENTCUBE.[Measures].[Creditos Promedio]
 AS IIF([Measures].[Creditos N] = 0, NULL, [Measures].[Creditos] / [Measures].[Creditos N]), 
FORMAT_STRING = "#.##0,00;-#.##0,00", 
VISIBLE = 1  ; 
CREATE MEMBER CURRENTCUBE.[Measures].[Duracion Promedio]
 AS IIF([Measures].[Duracion Periodos N] = 0, NULL, [Measures].[Duracion Periodos] / [Measures].[Duracion Periodos N]), 
FORMAT_STRING = "#.##0,00;-#.##0,00", 
VISIBLE = 1  ; 
CREATE MEMBER CURRENTCUBE.[Measures].[Vigencia Promedio]
 AS IIF([Measures].[Vigencia Anios N] = 0, NULL, [Measures].[Vigencia Anios] / [Measures].[Vigencia Anios N]), 
FORMAT_STRING = "#.##0,00;-#.##0,00", 
VISIBLE = 1  ; 
CREATE MEMBER CURRENTCUBE.[Measures].[Costo Matricula Promedio]
 AS IIF([Measures].[Costo Matricula N] = 0, NULL, [Measures].[Costo Matricula] / [Measures].[Costo Matricula N]), 
FORMAT_STRING = "#.##0,00;-#.##0,00", 
VISIBLE = 1  ; </Text>
            </Command>
          </Commands>
        </MdxScript>
      </MdxScripts>
    </Cube>
  </Cubes>
